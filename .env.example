# Apenas desenvolvimento. Copie para .env e substitua a senha antes de iniciar.
APP_ENV=development
POSTGRES_DB=salvadindin_v2
POSTGRES_USER=salvadindin
POSTGRES_PASSWORD=replace-with-a-random-local-password
# Execução fora do Docker: use um PostgreSQL dedicado de desenvolvimento.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Opcional: DATABASE_URL substitui POSTGRES_* somente no backend fora do Compose.
# DATABASE_URL=postgresql+psycopg://user:encoded-password@localhost:5432/database
BACKEND_PORT=18000
FRONTEND_PORT=15173
# Proxy Vite local; não é enviado ao navegador.
API_PROXY_TARGET=http://127.0.0.1:18000
