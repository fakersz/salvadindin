# Example only; production secrets live outside Git in /etc/salvadindin/backend.env.
# Create that directory as root (0700) and the file as root (0600).
APP_ENV=production
POSTGRES_DB=salvadindin_v2
POSTGRES_USER=salvadindin_app
POSTGRES_PASSWORD=replace-with-a-random-exclusive-password
POSTGRES_SOCKET_DIR=/run/postgresql
POSTGRES_PORT=5432
# Manual development: omit POSTGRES_SOCKET_DIR to use TCP localhost.
# Optional: DATABASE_URL overrides POSTGRES_* for manual execution only.
# Compose env_file path override (set in shell or a local .env):
# SALVADINDIN_ENV_FILE=/absolute/private/backend.env
