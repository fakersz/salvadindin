{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {"()": "app.core.safe_logging.SafeFormatter", "format": "%(asctime)s %(levelname)s %(name)s %(message)s"},
    "access": {"()": "app.core.safe_logging.SafeAccessFormatter", "format": "%(asctime)s %(levelname)s %(message)s"}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "formatter": "safe", "stream": "ext://sys.stderr"},
    "access": {"class": "logging.StreamHandler", "formatter": "access", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": [], "level": "INFO", "propagate": true},
    "uvicorn.access": {"handlers": ["access"], "level": "INFO", "propagate": false}
  },
  "root": {"handlers": ["default"], "level": "INFO"}
}
